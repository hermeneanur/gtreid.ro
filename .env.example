# Copy to .env.local for local development. In production, set these in your
# hosting dashboard (Vercel: Project → Settings → Environment Variables).
# Never commit real values.

# Where form submissions are delivered.
NOTIFICATION_EMAIL=hermeneanur@gmail.com

# Option A (recommended): Gmail SMTP.
# SMTP_PASS must be a Google "App Password" (16 characters), not the normal
# Gmail password. It requires 2-Step Verification on the Google account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hermeneanur@gmail.com
SMTP_PASS=

# Option B (fallback, used only if SMTP fails or is not set): Resend.
# RESEND_FROM must use a domain verified in Resend, e.g. "gtreiD <comenzi@gtreid.ro>".
# Without a verified domain, Resend only delivers to the Resend account owner.
RESEND_API_KEY=
RESEND_FROM=
